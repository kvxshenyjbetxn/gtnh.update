{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTNH Updater",
  "version": "0.1.1",
  "identifier": "app.gtnh.updater",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "GTNH Updater", "width": 1120, "height": 800, "minWidth": 760, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:" }
  },
  "bundle": { "active": false, "icon": ["icons/128x128.png", "icons/icon.icns", "icons/icon.ico"] }
}
